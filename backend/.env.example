# Copy to backend/.env. All keys are prefixed RECKONER_.
# Headless Path of Building — enables POST /builds/recalculate. Install with scripts/install_pob.sh.
RECKONER_POB_SRC=../.engines/pob/src
RECKONER_POB_SOURCE_COMMIT=ed354c2f8c42e148bc904c7508dbe851fb2cf952
RECKONER_LUAJIT_BIN=luajit

# Corpus (PostgreSQL + pgvector). docker compose up -d db, or a local server.
RECKONER_DATABASE_URL=postgresql+asyncpg://reckoner:reckoner@localhost:5432/reckoner

# Knowledge embeddings: auto (local fastembed model if installed, else hash) | hash
RECKONER_EMBEDDER=auto

# Agent (SPEC § 9). Default: a free local model through Ollama (brew install ollama; ollama pull qwen2.5:7b).
RECKONER_LLM=openai_compat            # openai_compat | anthropic | scripted
RECKONER_LLM_BASE_URL=http://localhost:11434/v1
RECKONER_LLM_MODEL=qwen2.5:7b
# RECKONER_LLM_API_KEY=...            # for hosted OpenAI-compatible tiers (Groq, Mistral, OpenRouter, Gemini)
# RECKONER_ANTHROPIC_API_KEY=...      # with RECKONER_LLM=anthropic and RECKONER_LLM_MODEL=claude-sonnet-5
